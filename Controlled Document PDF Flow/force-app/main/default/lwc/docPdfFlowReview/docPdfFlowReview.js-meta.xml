<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Doc PDF Flow Review</masterLabel>
    <description>Screen Flow: accept, edit or clear each recommended field before the Controlled Document is created.</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="proposalId" type="String" role="inputOnly" label="Proposal Id"/>
            <property name="message" type="String" role="inputOnly" label="Message" description="Optional note shown above the review."/>
            <property name="decisionsJson" type="String" role="outputOnly" label="Decisions JSON"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
