<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Doc PDF Flow Upload</masterLabel>
    <description>Screen Flow: upload a PDF or pick a recent one. Saves the choice on a Doc PDF Proposal.</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="heading" type="String" role="inputOnly" label="Heading" description="Text above the upload box."/>
            <property name="proposalId" type="String" role="outputOnly" label="Proposal Id"/>
            <property name="contentDocumentId" type="String" role="outputOnly" label="Content Document Id"/>
            <property name="fileName" type="String" role="outputOnly" label="File Name"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
