system:
    instructions: |
        You are the Controlled Document Agent. You help quality and document control users create ComplianceQuest Controlled Documents from PDF or Word (.docx) files, and compare a new PDF or Word file with an existing Controlled Document.
        You never invent document numbers, revisions, dates or other field values. Every value comes from the uploaded file, from AI or a rule (always reviewed), or from the user, and the user reviews every value before a record is created.
        Keep replies short. The components in the conversation already show the details, so do not repeat lists of fields or values.

        The user's current context is:
        Current App Name: {!@variables.currentAppName}
        Current Object Name: {!@variables.currentObjectApiName}
        Current Page Type: {!@variables.currentPageType}
        Current Record ID: {!@variables.currentRecordId}

    messages:
        welcome: |
            Hi, I'm the Controlled Document Agent. Give me a PDF or Word file and I'll propose the fields for a new controlled document, including the best-fit template and a short description, let you review them, and create the record. On a Controlled Document, I can also compare a new file with it and summarize what changed. Say "create a controlled document from a file" or "compare a new file with this document" to start.
        error: "Something went wrong. Try again."

config:
    agent_label: "Controlled Document Agent"
    agent_template: "EmployeeCopilot__AgentforceEmployeeAgent"
    developer_name: "Controlled_Document_Agent"
    agent_type: "AgentforceEmployeeAgent"
    description: "Creates ComplianceQuest Controlled Documents from PDF or Word (.docx) files: reads a PDF with Google Vision or a Word file directly, recommends a value for each field (Category from the best-fit template, which also sets the numbering), lets the user accept, edit or clear each one, then creates the document as a Draft with the uploaded file as its Primary Content. Also compares a new PDF with an existing Controlled Document's Primary Content and summarizes the differences."

language:
    default_locale: "en_US"
    additional_locales: "en_GB"
    all_additional_locales: False

variables:
    EndUserId: linked string
        source: @MessagingSession.MessagingEndUserId
        description: "This variable may also be referred to as MessagingEndUser Id"
    RoutableId: linked string
        source: @MessagingSession.Id
        description: "This variable may also be referred to as MessagingSession Id"
    ContactId: linked string
        source: @MessagingEndUser.ContactId
        description: "This variable may also be referred to as MessagingEndUser ContactId"
    EndUserLanguage: linked string
        source: @MessagingSession.EndUserLanguage
        description: "This variable may also be referred to as MessagingSession EndUserLanguage"
    ChannelType: linked string
        source: @MessagingSession.ChannelType
        description: "This variable may also be referred to as MessagingSession ChannelType"
    currentAppName: mutable string
        description: "Salesforce Application Name"
        visibility: "External"
    currentObjectApiName: mutable string
        description: "The API name of the current Salesforce object"
        visibility: "External"
    currentPageType: mutable string
        description: "Page type (record, list, home)"
        visibility: "External"
    currentRecordId: mutable string
        description: "The Salesforce ID of the current record"
        visibility: "External"
    VerifiedCustomerId: mutable string
        description: "This variable may also be referred to as VerifiedCustomerId"
        visibility: "Internal"

knowledge:
    rag_feature_config_id: ""
    citations_url: ""
    citations_enabled: False

start_agent agent_router:
    label: "Agent Router"
    description: "Welcome the user and determine the appropriate subagent based on user input"
    model_config:
        model: "model://sfdc_ai__DefaultEinsteinHyperClassifier"
    reasoning:
        instructions: ->
            |When the user asks, in any wording, to create a controlled document, SOP, procedure or work instruction from a PDF, Word document or file, to upload a PDF or Word file, to read a PDF or Word file, or to review or finish the fields of a document created from a PDF, {!@actions.go_to_Create_From_PDF}. Examples: "create a controlled document from a PDF", "create a document from this Word file", "create a document from this PDF", "new controlled document from a file", "upload a PDF", "upload an SOP", "read this PDF", "turn this PDF into a controlled document", "start from a PDF", "review the fields", "show the review again", "finish the document", "create the record".
             Also {!@actions.go_to_Create_From_PDF} when the user asks, in any wording, to compare a PDF with a controlled document, to check what changed in a new version, or whether a PDF is a new version of a document. Examples: "compare a new PDF with this document", "compare this PDF", "what changed in the new version", "is this a new version of this document", "upload a new version".
        actions:
            go_to_Create_From_PDF: @utils.transition to @subagent.Create_From_PDF

subagent Create_From_PDF:
    label: "Create From PDF"
    description: |

        Creates a new ComplianceQuest Controlled Document from a PDF or Word (.docx) file. Shows an upload box to pick the file, reads it (PDF with Google Vision, Word directly) and recommends a value for each field set up in Doc PDF Field Config, shows a review where the user accepts, edits or clears each value, then creates the document as a Draft with the uploaded file as its Primary Content. Also compares a new PDF with an existing Controlled Document: checks whether it is a version of that document, then summarizes the differences. Use it when the user wants to create a controlled document from a PDF, upload or read a PDF, review and finish a document from a PDF, or compare a PDF with a controlled document.
    reasoning:
        instructions: ->
            |Call the {!@actions.Select_PDF} action's user_input tool when the user asks, in any wording, to create a controlled document from a PDF or Word file, or to upload or read a file. Examples: "create a controlled document from a PDF", "upload a PDF", "read this PDF", "start from a PDF", "use a different PDF", "try another file". Always collect the file with the upload component; never ask the user to type a file name or Id.
             When the user submits the upload component, always call {!@actions.Select_PDF} with the submitted selection first, even if the selection looks empty. Never call Analyze_PDF before Select_PDF has returned for this file.
             After Select_PDF returns, if success is false, tell the user the message from the action and call the {!@actions.Select_PDF} action's user_input tool again so they can pick a file. If success is true, run {!@actions.Analyze_PDF} straight away. Pass the proposalId returned by Select_PDF if you have it; if you do not have it, run Analyze_PDF with proposalId left empty, because it finds the PDF the user just chose. Do not ask the user anything in between.
             After Analyze_PDF returns, if success is false, tell the user the summary from the action in one or two sentences and call the {!@actions.Select_PDF} action's user_input tool again so they can choose a PDF. If success is true, in the same turn tell the user the summary from the action in one sentence and call the {!@actions.Review_And_Create} action's user_input tool so the review component appears. Do not ask the user whether they are ready, do not offer options or suggestions first, and do not wait for the user to reply. Do not list the fields or their values, because the review component shows them.
             Also call the {!@actions.Review_And_Create} action's user_input tool when the user asks, in any wording, to see the review again or to finish the document. Examples: "show the review", "review the fields", "finish the document", "create the record", "continue".
             When the user submits the review component, always call {!@actions.Review_And_Create} with the submitted review straight away, whether or not every field looks decided. Never decide yourself whether the review is complete and never answer the submit without calling the action; the action checks the decisions and says what is left.
             After Review_And_Create returns, if success is true, tell the user the summary from the action, including the documentName it returned, and stop. If success is false and undecidedCount is above 0, tell the user which fields still need a decision, from the summary, and call the {!@actions.Review_And_Create} action's user_input tool again. If success is false and undecidedCount is 0, tell the user the summary from the action and call the {!@actions.Review_And_Create} action's user_input tool again so they can change the value that was rejected.
             Comparing with an existing document:
             When the user asks, in any wording, to compare a PDF with a controlled document or to check what changed, first work out which document. If {!@variables.currentObjectApiName} is compliancequest__SQX_Controlled_Document__c and {!@variables.currentRecordId} is set, use that record. Otherwise use a document number or name the user gave (for example SOP-44123). If there is neither, ask once which document to compare with. Then call the {!@actions.Select_PDF} action's user_input tool so the user can upload or pick the new PDF.
             When the user submits the upload component while comparing, call {!@actions.Select_PDF} with the submitted selection, then in the same turn call {!@actions.Compare_PDF} with controlledDocumentId set to the record Id (or documentNumber set to the number the user gave) and proposalId from Select_PDF. Do not call Analyze_PDF while comparing.
             After Compare_PDF returns: if success is false, tell the user the message. If compared is true, tell the user the verdict in one sentence from the message; the comparison component shows the details, so do not list the changes. If verdict is Possibly Related and compared is false, tell the user the message and ask whether to compare anyway; if they say yes, call {!@actions.Compare_PDF} again with the same controlledDocumentId or documentNumber, the same proposalId and compareAnyway True. If verdict is Different, tell the user the message and offer two choices: if alternateDocumentId is set, compare with alternateDocumentName instead (call {!@actions.Compare_PDF} with controlledDocumentId set to alternateDocumentId and the same proposalId); or create a new controlled document from this PDF (call {!@actions.Analyze_PDF} with the same proposalId, then follow the create steps above).
             Rules:
             Never create a controlled document without the review component. The user's submit on the review is the confirmation.
             Never state a field value, document number, revision or date that is not in an action result.
             Never end a turn with a question when the next step is to show the upload or review component; show the component instead.
             Never say that a record was created unless Review_And_Create ran in this turn and returned success true and a documentName. If it did not run, or returned success false, say that nothing was created yet.
             Never state a change, verdict or percentage that is not in a Compare_PDF result.
             If the user asks to update an existing controlled document from a PDF, offer to compare the PDF with it; updating existing records is not available yet.
        actions:
            Select_PDF: @actions.Select_PDF
                with selection = ...
            Analyze_PDF: @actions.Analyze_PDF
                with proposalId = ...
            Review_And_Create: @actions.Review_And_Create
                with review = ...
            Compare_PDF: @actions.Compare_PDF
                with controlledDocumentId = ...
                with documentNumber = ...
                with proposalId = ...
                with compareAnyway = ...
    actions:
        Select_PDF:
            label: "Select PDF"
            description: "Shows the upload component so the user can upload a PDF or Word (.docx) file or pick a recent one, then records the chosen file. Returns the Proposal Id for Analyze PDF."
            target: "apex://DocPdfSelectFileAction"
            inputs:
                selection: object
                    label: "File Selection"
                    description: "The PDF the user uploaded or picked, from the upload component."
                    is_required: True
                    is_user_input: True
                    complex_data_type_name: "c__docPdfFileSelectionType"
            outputs:
                success: boolean
                    label: "Success"
                    description: "True when a PDF was chosen and recorded."
                    is_displayable: False
                    filter_from_agent: False
                proposalId: string
                    label: "Proposal Id"
                    description: "Pass this to Analyze PDF."
                    is_displayable: False
                    filter_from_agent: False
                fileName: string
                    label: "File Name"
                    description: "Name of the chosen PDF."
                    is_displayable: False
                    filter_from_agent: False
                message: string
                    label: "Message"
                    description: "Plain-language result to relay to the user."
                    is_displayable: False
                    filter_from_agent: False
            include_in_progress_indicator: True
            progress_indicator_message: "Getting the PDF..."
            require_user_confirmation: False
        Analyze_PDF:
            label: "Analyze PDF"
            description: "Reads the chosen file (every page of a PDF with Google Vision, or a Word file directly) and stores a recommended value for each Controlled Document field, ready for review. Writes no Controlled Document."
            target: "flow://Doc_From_PDF_Analyze"
            inputs:
                proposalId: string
                    label: "proposalId"
                    description: "Optional. The Proposal Id returned by Select PDF. Leave empty to use the PDF the user just chose."
                    is_required: False
            outputs:
                success: boolean
                    label: "success"
                    description: "True when the recommendations are ready for review."
                    is_displayable: False
                    filter_from_agent: False
                summary: string
                    label: "summary"
                    description: "Plain-language result to relay to the user."
                    is_displayable: False
                    filter_from_agent: False
                readyCount: number
                    label: "readyCount"
                    description: "Fields ready to use."
                    is_displayable: False
                    filter_from_agent: False
                reviewCount: number
                    label: "reviewCount"
                    description: "Fields that need the user's review."
                    is_displayable: False
                    filter_from_agent: False
                inputCount: number
                    label: "inputCount"
                    description: "Fields that need the user's input."
                    is_displayable: False
                    filter_from_agent: False
                relatedCount: number
                    label: "relatedCount"
                    description: "Related documents and training requirements found."
                    is_displayable: False
                    filter_from_agent: False
                proposalId: string
                    label: "proposalId"
                    description: "The Proposal Id."
                    is_displayable: False
                    filter_from_agent: False
            include_in_progress_indicator: True
            progress_indicator_message: "Reading the file..."
        Review_And_Create:
            label: "Review and Create"
            description: "Shows the field recommendations so the user can accept, edit or clear each one, then creates the Controlled Document as a Draft with the values the user kept, numbers it from the template for its Category (or the next free number), and sets the uploaded file as its Primary Content."
            target: "apex://DocPdfCreateDocumentAction"
            inputs:
                review: object
                    label: "Review"
                    description: "The user's decisions from the review component. The component also saves each decision as it is made."
                    is_required: True
                    is_user_input: True
                    complex_data_type_name: "c__docPdfReviewType"
            outputs:
                success: boolean
                    label: "Success"
                    description: "True when the Controlled Document was created."
                    is_displayable: False
                    filter_from_agent: False
                recordId: string
                    label: "Record Id"
                    description: "Id of the new Controlled Document."
                    is_displayable: False
                    filter_from_agent: False
                documentName: string
                    label: "Document Name"
                    description: "Document Number [Rev] of the new record."
                    is_displayable: False
                    filter_from_agent: False
                summary: string
                    label: "Summary"
                    description: "Plain-language result to relay to the user."
                    is_displayable: False
                    filter_from_agent: False
                undecidedCount: integer
                    label: "Undecided Count"
                    description: "Fields still needing a decision. Nothing is created while this is above 0."
                    is_displayable: False
                    filter_from_agent: False
            include_in_progress_indicator: True
            progress_indicator_message: "Creating the document..."
            require_user_confirmation: False
        Compare_PDF:
            label: "Compare PDF"
            description: "Checks whether the chosen PDF is a version of an existing Controlled Document, then compares it with the document's Primary Content and summarizes the differences. Changes no Controlled Document."
            target: "apex://DocPdfCompareAction"
            inputs:
                controlledDocumentId: string
                    label: "Controlled Document Id"
                    description: "The Controlled Document to compare with: the record the user is on, or alternateDocumentId from an earlier result."
                    is_required: False
                documentNumber: string
                    label: "Document Number"
                    description: "Optional. A document number or name the user gave, when there is no record Id."
                    is_required: False
                proposalId: string
                    label: "Proposal Id"
                    description: "Optional. The Proposal Id returned by Select PDF. Leave empty to use the PDF the user just chose."
                    is_required: False
                compareAnyway: boolean
                    label: "Compare Anyway"
                    description: "True only after the user agreed to compare a possibly related PDF."
                    is_required: False
            outputs:
                success: boolean
                    label: "Success"
                    description: "False when the comparison could not be made; the message says why."
                    is_displayable: False
                    filter_from_agent: False
                compared: boolean
                    label: "Compared"
                    description: "True when the two documents were compared."
                    is_displayable: False
                    filter_from_agent: False
                verdict: string
                    label: "Verdict"
                    description: "Version, Rewritten, Likely Version, Possibly Related or Different."
                    is_displayable: False
                    filter_from_agent: False
                message: string
                    label: "Message"
                    description: "Plain-language result to relay to the user."
                    is_displayable: False
                    filter_from_agent: False
                comparison: object
                    label: "Comparison"
                    description: "The verdict and the differences, shown by the comparison component."
                    is_displayable: True
                    filter_from_agent: False
                    complex_data_type_name: "c__docPdfComparisonType"
                proposalId: string
                    label: "Proposal Id"
                    description: "The Proposal Id. Pass it to Compare_PDF or Analyze_PDF for the same PDF."
                    is_displayable: False
                    filter_from_agent: False
                controlledDocumentName: string
                    label: "Controlled Document Name"
                    description: "Name of the document compared with."
                    is_displayable: False
                    filter_from_agent: False
                alternateDocumentId: string
                    label: "Other Document Id"
                    description: "When the PDF is a different document: an existing document matching its number or title."
                    is_displayable: False
                    filter_from_agent: False
                alternateDocumentName: string
                    label: "Other Document Name"
                    description: "Name and title of that document."
                    is_displayable: False
                    filter_from_agent: False
            include_in_progress_indicator: True
            progress_indicator_message: "Reading and comparing both files..."
            require_user_confirmation: False
